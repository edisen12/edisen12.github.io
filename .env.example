# ==============================================================================
# HH Offshore · Infotec Brasil — Variáveis de Ambiente (.env.example)
# ==============================================================================
# REPOSITÓRIO PÚBLICO: Nunca insira segredos, senhas ou service_role neste arquivo.
# Copie este arquivo para .env.local para desenvolvimento local.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. TOPOLOGIA DA APLICAÇÃO (Obrigatório)
# Valores suportados: 'baas' | 'self-hosted'
# ------------------------------------------------------------------------------
# 'baas': SPA estática (GitHub Pages / Jamstack) comunicando-se com Backend-as-a-Service
# 'self-hosted': Servidor Fullstack próprio (VPS / Docker Compose) com Nginx + Backend Node
VITE_TOPOLOGY=baas

# ------------------------------------------------------------------------------
# 2. CONFIGURAÇÃO PARA TOPOLOGIA 'baas'
# ------------------------------------------------------------------------------
# Provedor BaaS ativo (padrão: 'supabase'). Aceita 'supabase', 'firebase', etc.
# NOTA DE SEGURANÇA: Bancos puros (postgres, mysql, mongodb, sqlite, etc.)
# são terminantemente PROIBIDOS aqui e exigem VITE_TOPOLOGY=self-hosted.
VITE_BAAS_PROVIDER=supabase

# Origens adicionais permitidas na política CSP (connect-src).
# Deixe em branco se utilizar o Supabase padrão do contrato.
VITE_BAAS_CONNECT_ORIGINS=

# Configuração do Provedor Supabase (quando VITE_BAAS_PROVIDER=supabase)
# Chaves públicas anônimas com RLS ativo no banco de dados.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ------------------------------------------------------------------------------
# 3. CONFIGURAÇÃO PARA TOPOLOGIA 'self-hosted' (VPS / Docker)
# ------------------------------------------------------------------------------
# Na topologia self-hosted, a autenticação ocorre via Cookie HttpOnly + CSRF.
# NENHUMA credencial de banco de dados (DATABASE_URL, senhas) deve levar o prefixo VITE_.
#
# URL da API do backend privado (opcional se servido no mesmo domínio via proxy /api)
# VITE_API_URL=
